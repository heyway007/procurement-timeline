DATABASE_URL="postgresql://user:password@host:5432/timeline?sslmode=require"
TEST_DATABASE_URL="postgresql://user:password@host:5432/timeline_test?sslmode=require"
SHADOW_DATABASE_URL="postgresql://user:password@host:5432/timeline_shadow?sslmode=require"
HOLIDAY_PREVIEW_SECRET="replace-with-a-long-random-secret"

# Authentication is disabled until an operator explicitly configures a provider.
# Auth User, Session, and login-attempt records always require PostgreSQL.
AUTH_PROVIDER="disabled"
# Mock only: JSON array of {externalUserId,email,displayName,passwordHash}.
# Generate each hash using hashMockPassword() from lib/auth/password.ts.
AUTH_MOCK_USERS_JSON="[]"
# Local administrator bootstrap allowlist; applies only when a User is created.
AUTH_ADMIN_EXTERNAL_IDS_JSON="[]"
# External provider provisional POST {email,password} -> {user:{id,email,name}}.
AUTH_EXTERNAL_URL=""
AUTH_EXTERNAL_PROVIDER_ID=""
AUTH_EXTERNAL_API_KEY=""

# Backend storage mode: postgres (default) or google_drive.
# Set APP_ENV=local for the local Drive file, and APP_ENV=production for prod.
APP_ENV="local"
STORAGE_MODE="postgres"

# Google Drive storage mode stores all data in one JSON file.
# Local defaults to procurement-timeline-data.local.json.
# Production defaults to procurement-timeline-data.json.
# Create a Google Cloud service account, share the target file/folder with
# GOOGLE_DRIVE_CLIENT_EMAIL, then set STORAGE_MODE="google_drive".
GOOGLE_DRIVE_CLIENT_EMAIL="timeline-service@example.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_PRIVATE_KEY_BASE64=""
GOOGLE_DRIVE_FILE_ID=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_FILE_NAME=""
