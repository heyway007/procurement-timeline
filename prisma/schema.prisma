generator client {
  provider = "prisma-client"
  runtime  = "workerd"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScheduleStatus {
  NORMAL
  NEEDS_REVIEW
}

enum HolidayScope {
  NATIONWIDE
  BANGKOK
}

enum HolidayOrigin {
  MANUAL
  OFFICIAL_SYNC
}

enum HolidaySyncStatus {
  FRESH
  CACHED
  FAILED
}

enum BudgetCategory {
  ONE_TO_FIVE_MILLION
  FIVE_TO_TEN_MILLION
  TEN_TO_TWENTY_MILLION
  ABOVE_TWENTY_MILLION
  SELECTIVE_METHOD
  SPECIFIC_METHOD_UNDER_500K
  SPECIFIC_METHOD_OVER_500K
}

enum ProjectStatusType {
  SLA_COMPLIANT
  SLA_NON_COMPLIANT
}

enum BidSubmissionTimeSlot {
  MORNING
  AFTERNOON
}

model Template {
  id        String         @id @default(uuid()) @db.Uuid
  key       String         @unique
  name      String
  version   Int
  steps     TemplateStep[]
  projects  Project[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model TemplateStep {
  id                String   @id @default(uuid()) @db.Uuid
  templateId        String   @db.Uuid
  order             Int
  label             String
  workingDaysToNext Int
  bidSubmissionTimeSlot BidSubmissionTimeSlot?
  template          Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, order])
  @@index([templateId])
}

model Project {
  id                           String         @id @default(uuid()) @db.Uuid
  name                         String
  ownerName                    String
  ownerUserId                  String?        @db.Uuid
  ownerUser                    User?          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  departmentName               String         @default("")
  budget                       Decimal        @db.Decimal(15, 2)
  budgetCategory               BudgetCategory
  projectStatusType            ProjectStatusType @default(SLA_COMPLIANT)
  startDate                    DateTime       @db.Date
  note                         String?
  templateId                   String         @db.Uuid
  templateVersion              Int
  processEndDate               DateTime       @db.Date
  isProcessEndManuallyAdjusted Boolean        @default(false)
  scheduleStatus               ScheduleStatus @default(NORMAL)
  version                      Int            @default(1)
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  template                     Template       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  steps                        ProjectStep[]

  @@index([name])
  @@index([ownerName])
  @@index([ownerUserId])
  @@index([departmentName])
  @@index([startDate, processEndDate])
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  externalUserId String
  email          String
  displayName    String
  role           UserRole  @default(USER)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  projects       Project[]

  @@unique([provider, externalUserId])
  @@index([email])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthLoginAttempt {
  emailHash       String   @id
  windowStartedAt DateTime
  attemptCount    Int

  @@index([windowStartedAt])
}

model ProjectStep {
  id                     String   @id @default(uuid()) @db.Uuid
  projectId              String   @db.Uuid
  order                  Int
  label                  String
  workingDaysToNext      Int
  scheduledDate          DateTime @db.Date
  isDateManuallyAdjusted Boolean  @default(false)
  bidSubmissionTimeSlot  BidSubmissionTimeSlot?
  project                Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
  @@index([projectId])
  @@index([scheduledDate])
}

model Holiday {
  id                  String        @id @default(uuid()) @db.Uuid
  date                DateTime      @unique @db.Date
  name                String
  sourceNote          String
  scope               HolidayScope  @default(NATIONWIDE)
  origin              HolidayOrigin @default(MANUAL)
  officialSourceUrl   String?
  officialSourceLabel String?
  lastConfirmedAt     DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model HolidayCalendarYear {
  year               Int       @id
  isVerifiedComplete Boolean   @default(false)
  sourceNote         String
  verifiedAt         DateTime?
  lastSyncAttemptAt  DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSyncStatus     HolidaySyncStatus?
  lastSyncMessage    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
